// ============================================
// Prisma Schema - Study Center Edumina
// Database: MySQL 8.0+
// ============================================

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUM
// ============================================

enum Role {
  admin
  operator
}

enum Status {
  active
  inactive
}

// ============================================
// MODEL: User (Akun Admin & Operator)
// ============================================

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique @db.VarChar(100)
  email        String   @unique @db.VarChar(150)
  password     String   @db.VarChar(255)
  nama_lengkap String   @db.VarChar(150)
  role         Role     @default(operator)
  status       Status   @default(active)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@index([username])
  @@index([email])
  @@map("users")
}

// ============================================
// MODEL: Aktivitas (Kegiatan Study Center)
// ============================================

model Aktivitas {
  id         Int      @id @default(autoincrement())
  judul      String   @db.VarChar(200)
  tanggal    DateTime @db.Date
  gambar     String   @db.VarChar(255)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([tanggal(sort: Desc)])
  @@map("aktivitas")
}

// ============================================
// MODEL: Produk
// ============================================

model Produk {
  id          Int      @id @default(autoincrement())
  nama_produk String   @db.VarChar(150)
  gambar      String   @db.VarChar(255)
  deskripsi   String?  @db.Text
  link_wa     String?  @db.VarChar(255)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@map("produk")
}

// ============================================
// MODEL: Paket Edukasi
// ============================================

model PaketEdukasi {
  id                Int      @id @default(autoincrement())
  judul             String   @db.VarChar(200)
  deskripsi_singkat String?  @db.Text
  deskripsi_lengkap String?  @db.LongText
  harga             Decimal  @db.Decimal(10, 2)
  durasi            String?  @db.VarChar(100)
  fasilitas         String?  @db.Text
  gambar            String   @db.VarChar(255)
  link_wa           String?  @db.VarChar(255)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  @@map("paket_edukasi")
}

// ============================================
// MODEL: Berita
// ============================================

model Berita {
  id              Int      @id @default(autoincrement())
  judul           String   @db.VarChar(250)
  slug            String   @unique @db.VarChar(255)
  isi_konten      String?  @db.LongText
  tanggal_publish DateTime @db.Date
  gambar          String   @db.VarChar(255)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@index([slug])
  @@index([tanggal_publish(sort: Desc)])
  @@map("berita")
}
