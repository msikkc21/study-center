# ==============================================
# .env.example - Study Center Edumina Backend
# Salin file ini ke .env dan isi nilainya
# ==============================================

NODE_ENV=development
PORT=5000

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=study_center_edumina

# Prisma DATABASE_URL
DATABASE_URL="mysql://root:your_password_here@localhost:3306/study_center_edumina"

# JWT
JWT_SECRET=change_this_to_a_very_long_random_secret_string_minimum_32_chars
JWT_EXPIRES_IN=24h

# CORS (pisahkan dengan koma jika lebih dari satu)
CORS_ORIGIN=http://localhost:3000

# Upload
MAX_FILE_SIZE=5242880

# API
API_BASE_URL=http://localhost:5000/api
