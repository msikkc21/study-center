# ==============================================
# .env.example - Template untuk Backend
# Salin file ini ke .env dan isi nilainya
# ==============================================

NODE_ENV=development
PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=study_center_db

# Prisma DATABASE_URL (sesuaikan dengan DB_* di atas)
DATABASE_URL="mysql://root:password@localhost:3306/study_center_db"

JWT_SECRET=change_this_to_a_strong_random_secret
JWT_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:3000

API_BASE_URL=http://localhost:5000/api
